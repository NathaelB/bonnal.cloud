---
import { formatDate } from '../lib/posts'
import { getTagLabel } from '../lib/tags'
import type { Author } from '../lib/authors'

interface Props {
  title: string
  description?: string
  date: Date
  tags: string[]
  cover?: string
  href: string
  locale?: string
  readingTime: number
  author?: Author
  class?: string
}

const { title, date, tags, cover, href, locale, class: className } = Astro.props
---

<article class:list={['group h-full', className]}>
  <a
    href={href}
    class="group relative flex h-full flex-col overflow-hidden rounded-[4px] border border-border bg-background transition-all duration-300 hover:-translate-y-1 hover:border-primary/40 hover:shadow-[0_18px_36px_-22px_rgba(0,0,0,0.45)]"
  >
    <span class="pointer-events-none absolute right-2 top-2 z-10 size-1.5 border border-primary/50" aria-hidden="true"></span>

    <!-- Thumbnail (light + dark variants, swapped by theme) -->
    <div class="aspect-16/10 shrink-0 overflow-hidden border-b border-border bg-muted">
      {cover ? (
        <img src={cover} alt={title} class="h-full w-full object-cover" loading="lazy" />
      ) : (
        <Fragment>
          <img src={`${href}/thumbnail.png`} alt={title} class="thumb-light h-full w-full object-cover" loading="lazy" />
          <img src={`${href}/thumbnail-dark.png`} alt={title} class="thumb-dark h-full w-full object-cover" loading="lazy" />
        </Fragment>
      )}
    </div>

    <!-- Body -->
    <div class="flex flex-1 flex-col p-4">
      {tags.length > 0 && (
        <div class="mb-3 flex flex-wrap gap-1.5">
          {tags.slice(0, 3).map((tag) => (
            <span class="rounded-[2px] border border-primary/30 bg-primary/[6%] px-1.5 py-1 font-mono text-[9px] font-semibold uppercase tracking-wider text-primary">
              {getTagLabel(tag)}
            </span>
          ))}
        </div>
      )}
      <time datetime={date.toISOString()} class="font-mono text-[10px] font-semibold uppercase tracking-[0.1em] text-muted-foreground">
        {formatDate(date, locale)}
      </time>
      <h2 class="mt-1.5 text-[15px] font-semibold leading-snug text-foreground line-clamp-3">
        {title}
      </h2>
    </div>
  </a>
</article>

<style>
  .thumb-dark {
    display: none;
  }
  :global(html.dark) .thumb-light {
    display: none;
  }
  :global(html.dark) .thumb-dark {
    display: block;
  }
</style>
