---
import { Icon } from "@iconify/react";

const areas = [
  {
    icon: "mdi:shield-key-outline",
    titleKey: "expertise.iam.title",
    descKey: "expertise.iam.description",
    title: "IAM & OIDC",
    description: "OIDC, OAuth2, FerrisKey, token lifecycle, multi-tenant realms and secure product boundaries. Protocol implementation from spec",
    eyb: "01 · IAM",
    span: "md:col-span-3",
  },
  {
    icon: "lucide:shield-check",
    titleKey: "expertise.authz.title",
    descKey: "expertise.authz.description",
    title: "Authorization & policy",
    description: "OPA, RBAC, ABAC, delegated authorization and policy-as-code. Fine-grained access control that stays auditable when security teams need answers.",
    eyb: "02 · AUTHZ",
    span: "md:col-span-3",
  },
  {
    icon: "lucide:server",
    titleKey: "expertise.platform.title",
    descKey: "expertise.platform.description",
    title: "Platform identity",
    description: "Kubernetes-native identity, service-to-service auth, mTLS and SPIFFE/SPIRE between workloads. IAM at the infrastructure layer.",
    eyb: "03 · K8S",
    span: "md:col-span-2",
  },
  {
    icon: "lucide:network",
    titleKey: "expertise.distributed.title",
    descKey: "expertise.distributed.description",
    title: "Distributed security",
    description: "Event-driven auth flows, Kafka-based audit pipelines, and consistency decisions for systems that stay explainable under failure.",
    eyb: "04 · DIST",
    span: "md:col-span-2",
  },
  {
    icon: "lucide:activity",
    titleKey: "expertise.ops.title",
    descKey: "expertise.ops.description",
    title: "Operational security",
    description: "Auth systems that are observable and recoverable. Structured audit logs, token flow metrics, and SLOs for security-critical infrastructure.",
    eyb: "05 · OPS",
    span: "md:col-span-2",
  },
];
---

<section class="relative py-24 sm:py-32">
  <div class="max-w-6xl mx-auto px-6">

    <!-- Header -->
    <div class="mb-12" data-reveal="fade-up">
      <p class="text-sm font-semibold text-primary uppercase tracking-widest mb-3" data-t="expertise.label">Expertise</p>
      <h2 class="text-3xl font-bold text-foreground sm:text-4xl" data-t="expertise.title">
        From identity to distributed platforms.
      </h2>
      <p class="mt-4 text-lg text-muted-foreground max-w-2xl" data-t="expertise.description">
        I focus on the parts of a system where product design, security constraints and operational reality meet.
      </p>
    </div>

    <!-- Connected matrix: 2 wide + 3 narrow cells sharing hairline borders -->
    <div
      class="grid grid-cols-1 gap-px overflow-hidden rounded-[4px] border border-border bg-border md:grid-cols-6"
      data-reveal="fade-up"
      data-reveal-delay="100"
    >
      {areas.map((area) => (
        <div class={`group relative overflow-hidden bg-background p-6 transition-colors duration-300 hover:bg-primary/[3.5%] ${area.span}`}>
          <!-- Grid texture -->
          <div
            class="pointer-events-none absolute inset-0 z-0 opacity-50"
            style="background-image: linear-gradient(to right, var(--color-border) 1px, transparent 1px), linear-gradient(to bottom, var(--color-border) 1px, transparent 1px); background-size: 34px 34px; mask-image: radial-gradient(ellipse 70% 60% at 85% 0%, black, transparent 72%); -webkit-mask-image: radial-gradient(ellipse 70% 60% at 85% 0%, black, transparent 72%);"
            aria-hidden="true"
          ></div>

          <div class="relative z-[1] flex flex-col">
            <div class="mb-4 flex items-center justify-between">
              <span class="flex size-9 items-center justify-center rounded-[3px] bg-primary/10 text-primary transition-colors duration-300 group-hover:bg-primary/15">
                <Icon icon={area.icon} className="size-4.5" client:load />
              </span>
              <span class="font-mono text-[10px] font-semibold uppercase tracking-[0.16em] text-primary">
                {area.eyb}
              </span>
            </div>
            <h3 class="text-lg font-semibold text-foreground" data-t={area.titleKey}>{area.title}</h3>
            <p class="mt-2 text-sm leading-relaxed text-muted-foreground" data-t={area.descKey}>{area.description}</p>
          </div>
        </div>
      ))}
    </div>

  </div>
</section>
