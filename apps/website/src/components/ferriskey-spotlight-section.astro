---
import { Icon } from "@iconify/react";
import { Button } from "@explainer/ui";
import { BackgroundAnimation } from "./background-animation";

const proofs = [
  {
    icon: "lucide:boxes",
    titleKey: "ferriskey.proof1.title",
    descKey: "ferriskey.proof1.description",
    title: "Architecture",
    description: "Hexagonal architecture in Rust. Service boundaries designed before the first line of code. API contracts that the entire stack depends on.",
    grad: "linear-gradient(135deg, oklch(0.74 0.17 46), oklch(0.68 0.19 41))",
    blurb: "Hexagonal · Rust",
  },
  {
    icon: "lucide:network",
    titleKey: "ferriskey.proof2.title",
    descKey: "ferriskey.proof2.description",
    title: "Distributed",
    description: "Multiple services on Kubernetes. Event-driven coordination, eventual consistency, and horizontal scalability by design.",
    grad: "linear-gradient(135deg, oklch(0.67 0.19 41), oklch(0.61 0.19 37))",
    blurb: "Kubernetes · events",
  },
  {
    icon: "lucide:activity",
    titleKey: "ferriskey.proof3.title",
    descKey: "ferriskey.proof3.description",
    title: "Production",
    description: "GitHub Actions CI/CD, Prometheus + Loki for observability, all held to SLO discipline so nothing just ships and gets forgotten.",
    grad: "linear-gradient(135deg, oklch(0.60 0.19 36), oklch(0.54 0.17 31))",
    blurb: "CI/CD · SLO",
  },
];

const tags = ["Rust", "Hexagonal", "Kubernetes", "Event-driven", "CI/CD", "Prometheus · Loki", "SLO"];

const corners = [
  { icon: "lucide:bookmark", pos: "top-4 left-4" },
  { icon: "lucide:file", pos: "top-4 right-4" },
  { icon: "lucide:folder", pos: "bottom-4 left-4" },
  { icon: "lucide:sparkle", pos: "bottom-4 right-4" },
];
---

<section
  id="ferriskey"
  class="relative py-24 sm:py-32 overflow-hidden"
  style="--color-primary: #f97316; --primary: #f97316; --color-sky-400: #f97316; --color-cyan-400: #fb923c;"
>
  <div
    class="absolute inset-0 -z-10 pointer-events-none"
    style="background: radial-gradient(ellipse at 20% 60%, color-mix(in oklch, var(--primary) 8%, transparent) 0%, transparent 60%);"
    aria-hidden="true"
  ></div>

  <div class="max-w-6xl mx-auto px-6">
    <!-- Eyebrow -->
    <p
      class="font-mono text-xs font-semibold uppercase tracking-[0.2em] text-primary"
      data-reveal="fade-up"
      data-t="ferriskey.label"
    >
      Flagship Product
    </p>

    <!-- Intro -->
    <div class="mt-6 max-w-3xl" data-reveal="fade-up" data-reveal-delay="60">
      <div class="flex items-center gap-4">
        <div class="flex items-center justify-center size-14 rounded-[6px] border border-primary/[28%] bg-primary/[12%]">
          <img src="https://ferriskey.rs/logo.svg" alt="FerrisKey" class="size-10" />
        </div>
        <div>
          <h2 class="text-2xl font-bold text-foreground sm:text-3xl" data-t="ferriskey.title">
            FerrisKey
          </h2>
          <p class="text-sm font-medium mt-0.5 text-primary" data-t="ferriskey.subtitle">
            Open-source IAM platform, built in Rust
          </p>
        </div>
      </div>

      <p class="mt-6 text-muted-foreground leading-relaxed" data-t="ferriskey.description">
        FerrisKey is an identity and access management platform built for production, the kind of system where correctness isn't optional. I co-founded it, designed the architecture, wrote the core, and I still own the production stack.
      </p>

      <div class="mt-8 flex flex-wrap gap-3">
        <Button size="default" className="cursor-pointer rounded-[3px]" client:load>
          <a href="https://ferriskey.rs" target="_blank" rel="noopener noreferrer" class="flex items-center gap-2">
            <Icon icon="lucide:globe" className="size-4" client:load />
            <span data-t="ferriskey.cta.website">Visit ferriskey.rs</span>
          </a>
        </Button>
        <Button variant="outline" size="default" className="cursor-pointer rounded-[3px]" client:load>
          <a href="https://github.com/ferriskey/ferriskey" target="_blank" rel="noopener noreferrer" class="flex items-center gap-2">
            <Icon icon="mdi:github" className="size-4" client:load />
            <span data-t="ferriskey.cta.github">View on GitHub</span>
          </a>
        </Button>
      </div>
    </div>

    <!-- Schematic panel: the 3 proofs as connected blocks -->
    <div
      class="relative mt-12 overflow-hidden rounded-[4px] border border-border bg-background"
      data-reveal="fade-up"
      data-reveal-delay="120"
    >
      <div class="absolute inset-0 z-0 opacity-30">
        <BackgroundAnimation client:only="react" />
      </div>
      <div
        class="absolute inset-0 z-[1] pointer-events-none opacity-50"
        style="background-image: linear-gradient(to right, var(--color-border) 1px, transparent 1px), linear-gradient(to bottom, var(--color-border) 1px, transparent 1px); background-size: 75px 75px; mask-image: radial-gradient(ellipse 92% 100% at 50% 50%, black 35%, transparent 92%); -webkit-mask-image: radial-gradient(ellipse 92% 100% at 50% 50%, black 35%, transparent 92%);"
        aria-hidden="true"
      ></div>

      {corners.map((c) => (
        <span class={`absolute z-[4] text-foreground/40 ${c.pos}`} aria-hidden="true">
          <Icon icon={c.icon} className="size-4.5" client:load />
        </span>
      ))}

      <div class="relative z-[3] flex flex-wrap items-center justify-center gap-y-5 px-8 py-16 min-h-[280px]">
        {proofs.map((proof, i) => (
          <>
            {i > 0 && (
              <div
                class="relative hidden h-[132px] w-[74px] shrink-0 items-center justify-center sm:flex"
                aria-hidden="true"
              >
                <span class="absolute inset-x-0 top-1/2 -translate-y-1/2 border-t-2 border-dashed border-foreground/45"></span>
                <span class="relative size-2 rotate-45 bg-foreground/70 shadow-sm"></span>
              </div>
            )}
            <div
              class="relative flex h-[132px] w-[210px] max-w-full shrink-0 flex-col justify-between overflow-hidden rounded-[3px] p-4 text-white shadow-lg shadow-primary/20"
              style={`background: ${proof.grad};`}
            >
              <span
                class="pointer-events-none absolute inset-0"
                style="background: linear-gradient(115deg, transparent 42%, rgba(255,255,255,0.2) 50%, transparent 58%);"
              ></span>
              <span class="relative z-[1] grid size-10 place-items-center rounded-[3px]" style="background: rgba(255,255,255,0.16);">
                <Icon icon={proof.icon} className="size-5 text-white" client:load />
              </span>
              <div class="relative z-[1]">
                <span class="block font-mono text-sm font-bold uppercase tracking-wider" data-t={proof.titleKey}>
                  {proof.title}
                </span>
                <span class="mt-1 block font-mono text-[10px] font-medium text-white/70">
                  {proof.blurb}
                </span>
              </div>
            </div>
          </>
        ))}
      </div>
    </div>

    <!-- Proof descriptions (your content) -->
    <dl class="mt-4 grid grid-cols-1 gap-px overflow-hidden rounded-[4px] border border-border bg-border sm:grid-cols-3" data-reveal="fade-up" data-reveal-delay="160">
      {proofs.map((proof) => (
        <div class="bg-background p-5">
          <dt class="flex items-center gap-2 font-mono text-[11px] font-semibold uppercase tracking-[0.1em] text-primary">
            <span class="size-1.5 bg-primary" aria-hidden="true"></span>
            <span data-t={proof.titleKey}>{proof.title}</span>
          </dt>
          <dd class="mt-2.5 text-sm leading-relaxed text-muted-foreground" data-t={proof.descKey}>
            {proof.description}
          </dd>
        </div>
      ))}
    </dl>

    <!-- Tech tags (from your content) -->
    <div class="mt-4 flex flex-wrap gap-2.5" data-reveal="fade-up" data-reveal-delay="200">
      {tags.map((tag) => (
        <span class="rounded-[3px] border border-primary/35 bg-primary/[5%] px-2.5 py-2 font-mono text-[11px] font-semibold uppercase tracking-[0.08em] text-primary">
          {tag}
        </span>
      ))}
    </div>
  </div>
</section>
